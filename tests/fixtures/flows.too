##! Flow syntax fixture.

struct SearchJob:
  query: Text
  reason?: Text

struct Note:
  title: Text
  summary: Text

struct Answer:
  text: Text

flow research(_: Part[]) -> Answer:
  models = gpt-5
  tools += web

  ## Produce one item.
  run normalize
  run -> Note: Extract one note.

  ## Expand one item into a list.
  scatter 5 using plan_searches
  scatter 5 using -> SearchJob:
    Create five search jobs.
  storm 3 using sample_direction in 2 lanes
  storm 3 in 2 lanes using -> SearchJob:
    Create one independent search job.

  ## Reduce a list into one item.
  gather using synthesize
  gather using -> Answer: Synthesize one answer.
  settle using merge_next
  settle using -> Answer:
    Merge this item into the accumulated answer.

  ## Transform and select list items.
  map using extract_note in 5 lanes
  map in 5 lanes using -> Note: Extract one note.
  keep first 5
  keep if useful in 5 lanes
  keep in 5 lanes if: Return true for useful items.
  drop last 2
  drop in 5 lanes if duplicate
  drop in 5 lanes if: Return true for duplicate items.
  sort descending by relevance in 5 lanes
  sort ascending in 5 lanes by: Score this item.

  ## Repeat with a count and optional condition.
  repeat 3 times:
    run improve
    until: Return true when complete.

flow delegate:
  seek reviewer review
  seek reviewer -> Answer:
    Review the current value.
  ask: Approve this result?

flow bindings:
  let jobs = scatter 5 using plan_searches
  let run publish
  let guidance =
    Prefer primary sources.
  repeat:
    run improve
    until:
      Return true when complete.

flow bare:
  Use the current input directly.
  Return the transformed parts.

flow empty:
  pass
