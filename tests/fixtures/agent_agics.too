agic chat(in: Part[]) -> Part[]:
  models = gpt-5
  tools += shell
  hands += summarize

  instruct default

  {{_}}

agic task(in: Part[]) -> Part[]:
  models = gpt-5
  tools += shell, filesystem
  skills += review
  services += github
  hands += plan, execute
  handoffs = support

  instruct default

  user:
    {{_}}

agic chore:
  models = gpt-5
  tools += shell
  handoffs = support, billing

  instruct default
  user:
    Run the scheduled maintenance chore and report the result.
