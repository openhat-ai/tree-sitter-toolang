#!/usr/bin/env toolang

thunk respond:
  pass

thunk echo(in: Text) -> Text:
  Echo the current input:
  {{_}}

thunk summarize(in: Part[]) -> Text:
  user:
    Summarize {{_}}.

thunk classify(in: Part[], labels: Text[]) -> Json:
  models = gpt-5

  user:
    Classify {{_}} into {{labels}}.

thunk decide(strict?: Boolean) -> Boolean:
  user:
    Decide whether the request should proceed.

thunk score(in: Part[], rubric?: Json) -> Number:
  user:
    Score {{_}} using {{rubric}}.

thunk render(template: Text, data: Json, notes?: Part[]) -> Part[]:
  instruct: default
  user: ```md
Render {{template}} with {{data}}.
{{notes}}
```
