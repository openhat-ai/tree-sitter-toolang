#!/usr/bin/env toolang

##! Program documentation.

## Review skill documentation.
skill review:
  source = by3gus/review
  description = Review support

  Use this skill for review workflows.

service github:
  protocol = http
  target = https://mcp.github.com/mcp

  Use GitHub for repository operations.

prompt rewrite:
  Rewrite {{_}} in the requested {{tone}} tone.

psyche rigorous:
  Prefer concrete findings.

## Review result documentation.
struct ReviewResult:
  ## Summary field documentation.
  summary: Text
  count?: Number
  ok: Boolean
  payload: Json
  messages: Part[]
  findings: Finding[]

instruct strict_json:
  Return only JSON.

context report:
  Include relevant report context before the user request.

agic report() -> Text:
  handoffs = support, billing
  hands += summarize
  recall = near

  instruct strict_json
  context report
  user:
    Generate a concise report.
