# top-level file comment
with skill briceyan/pdf-processing # inline with comment

service github: # inline cap header comment
  protocol = http
  target = https://mcp.github.com/mcp

  # body hash line is literal block content
  Use this service when the agent needs GitHub access.

struct ReviewResult:
  summary: Text # inline struct field comment

prompt review: # inline prompt header comment
  params = path, focus

  # prompt body hash line
  Review {{path}} carefully.
  {{focus}}

agic review(_: Part[], focus?: Text) -> ReviewResult: # inline agic header comment
  models = gpt-5 # inline directive comment

  instruct default
