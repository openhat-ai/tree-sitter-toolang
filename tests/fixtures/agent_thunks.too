thunk chat(input: Message) -> Message:
  models = gpt-5
  tools += shell
  delegates += summarize

  instruct: default

  system:
    Keep the conversation grounded and ask clarifying questions when needed.

  user:
    {{input}}

thunk task(input: Message, goal: Text, context?: Json) -> Json:
  models = gpt-5
  tools += shell, filesystem
  skills += review
  services += github
  delegates += plan, execute
  handoffs = support

  system:
    Complete the requested task and return structured progress.

  user:
    Goal: {{goal}}
    Context: {{context}}

thunk chore() -> Text:
  models = gpt-5
  tools += shell
  handoffs = support, billing

  system: default

  user:
    Run the scheduled maintenance chore and report the result.
