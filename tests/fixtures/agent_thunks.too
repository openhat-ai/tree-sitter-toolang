thunk chat:
  models = gpt-5
  tools += shell
  hands += summarize

  instruct:
    Keep the conversation grounded and ask clarifying questions when needed.

  user:
    {{input}}

thunk task(input: Message) -> Message:
  models = gpt-5
  tools += shell, filesystem
  skills += review
  services += github
  hands += plan, execute
  handoffs = support

  instruct:
    Complete the requested task and return structured progress.

  user:
    {{input}}

thunk chore:
  models = gpt-5
  tools += shell
  handoffs = support, billing

  instruct: default

  user:
    Run the scheduled maintenance chore and report the result.
