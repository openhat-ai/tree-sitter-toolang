# top-level file comment
with psyche toolang.ai/reviewer
with skill briceyan/pdf-processing # inline with comment
with service github://briceyan/caps/services/github@main
with prompt https://toolang.ai/review

psyche reviewer:
  Prefer concrete findings and direct language.

service github: # inline cap header comment
  protocol = http
  target = https://mcp.github.com/mcp

  Use this service when the agent needs GitHub access.

prompt review: # inline prompt header comment
  params = path, focus

  Review {{path}} carefully.
  {{focus}}

struct ReviewFinding:
  path: Text
  line?: Number # inline struct field comment

struct ReviewResult:
  summary: Text
  findings: ReviewFinding[]

instruct:
  You are running {{agic.name}}.

context:
  Use the current run context when preparing the final user message.

agic respond:
  instruct default

agic summarize:
  user:
    Summarize the current workspace in a concise style.

agic inspect() -> ReviewResult:
  user:
    Return a precise result.

agic review(in: Part[], path: Text, focus?: Text) -> ReviewResult:
  models = gpt-5 # inline directive comment
  psyches += reviewer
  skills += review, patch
  services -= linear
  tools = shell, filesystem
  recall = history, memory

  instruct default

  context default
  user:
    Review {{path}} carefully.
    {{focus}}

agic raw:
  instruct none
  context none
  user: none
