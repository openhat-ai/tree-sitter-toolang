#!/usr/bin/env toolang

agic respond:
  pass

agic echo(in: Text) -> Text:
  Echo the current input:
  {{_}}

agic summarize(in: Part[]) -> Text:
  user:
    Summarize {{_}}.

agic classify(in: Part[], labels: Text[]) -> Json:
  models = gpt-5

  user:
    Classify {{_}} into {{labels}}.

agic decide(strict?: Boolean) -> Boolean:
  user:
    Decide whether the request should proceed.

agic score(in: Part[], rubric?: Json) -> Number:
  user:
    Score {{_}} using {{rubric}}.

agic render(template: Text, data: Json, notes?: Part[]) -> Part[]:
  instruct default
  user:
    Render {{template}} with {{data}}.
    {{notes}}
