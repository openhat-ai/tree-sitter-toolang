  "recall";

default_keyword ::=
  "default";

none_keyword ::=
  "none";

_flow_keyword ::=
  with_keyword | struct_keyword | psyche_keyword | skill_keyword | service_keyword | prompt_keyword
  | chore_keyword | context_keyword | instruct_keyword | agic_keyword | flow_keyword | run_keyword |
  seek_keyword | ask_keyword | generate_keyword | map_keyword | reduce_keyword | keep_keyword |
  drop_keyword | sort_keyword | repeat_keyword | spawn_keyword | await_keyword | until_keyword |
  from_keyword | windowing_keyword | using_keyword | if_keyword | by_keyword | in_keyword |
  lane_keyword | lanes_keyword | ascending_keyword | descending_keyword | time_keyword |
  times_keyword | first_keyword | last_keyword | let_keyword | exec_keyword | async_keyword | "_" |
  (* alias {"value":"role","named":true} *) ( "user" ) | (* alias {"value":"role","named":true} *) (
  "assistant" ) | (* alias {"value":"role","named":true} *) ( "tool" ) | pass_keyword |
  (* alias {"value":"directive_key","named":true} *) ( "models" ) |
  (* alias {"value":"directive_key","named":true} *) ( "tools" ) |
  (* alias {"value":"directive_key","named":true} *) ( "skills" ) |
  (* alias {"value":"directive_key","named":true} *) ( "services" ) |
  (* alias {"value":"directive_key","named":true} *) ( "psyches" ) |
  (* alias {"value":"directive_key","named":true} *) ( "prompts" ) |
  (* alias {"value":"directive_key","named":true} *) ( "hands" ) |
  (* alias {"value":"directive_key","named":true} *) ( "handoffs" ) | recall_keyword;

_agic_keyword ::=
  (* alias {"value":"role","named":true} *) ( "user" ) | (* alias {"value":"role","named":true} *) (
  "assistant" ) | (* alias {"value":"role","named":true} *) ( "tool" ) | pass_keyword |
  (* alias {"value":"directive_key","named":true} *) ( "models" ) |
  (* alias {"value":"directive_key","named":true} *) ( "tools" ) |
  (* alias {"value":"directive_key","named":true} *) ( "skills" ) |
  (* alias {"value":"directive_key","named":true} *) ( "services" ) |
  (* alias {"value":"directive_key","named":true} *) ( "psyches" ) |
  (* alias {"value":"directive_key","named":true} *) ( "prompts" ) |
  (* alias {"value":"directive_key","named":true} *) ( "hands" ) |
  (* alias {"value":"directive_key","named":true} *) ( "handoffs" ) | recall_keyword | lanes_keyword
  | context_keyword | instruct_keyword;

_restricted_binding_word ::=
  until_keyword | "_";

optional_marker ::=
  "?";

assign_operator ::=
  "=";

arrow ::=
  "->";

colon ::=
  ":";

lparen ::=
  "(";

rparen ::=
  ")";

comma ::=
  ",";

_cap_kind ::=
  (* alias {"value":"cap_kind","named":true} *) ( psyche_keyword ) |
  (* alias {"value":"cap_kind","named":true} *) ( skill_keyword ) |
  (* alias {"value":"cap_kind","named":true} *) ( service_keyword ) |
  (* alias {"value":"cap_kind","named":true} *) ( prompt_keyword );

_word ::=
  (* token *) ( ? regex "[A-Za-z_][A-Za-z0-9_]*" ? );

type_name ::=
  (* token *) ( ? regex "[A-Z][A-Za-z0-9]*" ? );

identifier ::=
  _identifier;

_identifier ::=
  (* token *) ( ? regex "[a-z][a-z0-9_]*(_[a-z0-9]+)*" ? );

_snake_kebab_name ::=
  (* token *) ( ? regex "[a-z][a-z0-9_-]*" ? );

text_line ::=
  _text_line;

_text_line ::=
  (* token *) ( (* prec -1 *) ( ? regex "[^#\\r\\n]+" ? ) );

_literal_text_line ::=
  (* token *) ( (* prec -1 *) ( ? regex "[ \\t]*[^ \\t\\r\\n][^\\r\\n]*" ? ) );

_diagnostic_text ::=
  (* token *) ( (* prec -1 *) ( ? regex "[^ \\t#\\r\\n][^#\\r\\n]*" ? ) );

newline ::=
  ? external scanner token "newline" ?;

blank_line ::=
  ? external scanner token "blank_line" ?;

_comment_start ::=
  ? external scanner token "_comment_start" ?;

plain_comment ::=
  ? external scanner token "plain_comment" ?;

