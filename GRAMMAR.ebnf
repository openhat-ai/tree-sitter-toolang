_recall_source ::=
  (* alias {"value":"recall_source","named":true} *) ( "far" ) |
  (* alias {"value":"recall_source","named":true} *) ( "near" );

_directives ::=
  (* prec.right 0 *) ( (* field "directive" *) ( _directive_entry ) ( (* field "directive" *) (
  _directive_entry ) | _trivia )* );

_text_ref ::=
  "default" | "none" | identifier;

_messages ::=
  (* prec.right 0 *) ( (* field "message" *) ( _message_entry ) ( (* field "message" *) (
  _message_entry ) | _trivia )* );

_message_entry ::=
  message | _line_start invalid_agic_message;

message ::=
  _line_start ( (* field "role" *) ( _role ) ":" ( (* field "content" *) (
  (* alias {"value":"content","named":true} *) ( _inline_content ) ) _text_end | (* prec.right 0 *)
  ( _text_end (* field "content" *) ( (* alias {"value":"content","named":true} *) ( _block_content
  ) ) ) ) | (* field "content" *) ( (* alias {"value":"content","named":true} *) ( _message_content
  ) ) );

_message_content ::=
  (* prec.right 0 *) ( _unroled_message_line ( _unroled_message_line | blank_line
  _unroled_message_line )* blank_line? );

_unroled_message_line ::=
  (* alias {"value":"text","named":true} *) ( _agic_raw_text ) newline;

invalid_agic_message ::=
  (* prec.dynamic -2 *) ( _agic_keyword ( (* alias {"value":"text","named":true} *) ( _recovery_text
  ) )? _line_end );

_role ::=
  (* alias {"value":"role","named":true} *) ( "user" ) | (* alias {"value":"role","named":true} *) (
  "assistant" ) | (* alias {"value":"role","named":true} *) ( "tool" );

_pass_statement ::=
  (* prec 1 *) ( _line_start "pass" _line_end _trivia* );

_flow_keyword ::=
  "with" | "struct" | "psyche" | "skill" | "service" | "prompt" | "chore" | "context" | "instruct" |
  "agic" | "flow" | "run" | "seek" | "ask" | "generate" | "map" | "reduce" | "keep" | "drop" |
  "sort" | "repeat" | "spawn" | "await" | "until" | "from" | "windowing" | "using" | "if" | "by" |
  "in" | "lane" | "lanes" | "ascending" | "descending" | "time" | "times" | "first" | "last" | "let"
  | "exec" | "async" | "_" | (* alias {"value":"role","named":true} *) ( "user" ) |
  (* alias {"value":"role","named":true} *) ( "assistant" ) |
  (* alias {"value":"role","named":true} *) ( "tool" ) | "pass" |
  (* alias {"value":"directive_key","named":true} *) ( "models" ) |
  (* alias {"value":"directive_key","named":true} *) ( "tools" ) |
  (* alias {"value":"directive_key","named":true} *) ( "skills" ) |
  (* alias {"value":"directive_key","named":true} *) ( "services" ) |
  (* alias {"value":"directive_key","named":true} *) ( "psyches" ) |
  (* alias {"value":"directive_key","named":true} *) ( "prompts" ) |
  (* alias {"value":"directive_key","named":true} *) ( "hands" ) |
  (* alias {"value":"directive_key","named":true} *) ( "handoffs" ) |
  (* alias {"value":"directive_key","named":true} *) ( "recall" );

_agic_keyword ::=
  (* alias {"value":"role","named":true} *) ( "user" ) | (* alias {"value":"role","named":true} *) (
  "assistant" ) | (* alias {"value":"role","named":true} *) ( "tool" ) | "pass" |
  (* alias {"value":"directive_key","named":true} *) ( "models" ) |
  (* alias {"value":"directive_key","named":true} *) ( "tools" ) |
  (* alias {"value":"directive_key","named":true} *) ( "skills" ) |
  (* alias {"value":"directive_key","named":true} *) ( "services" ) |
  (* alias {"value":"directive_key","named":true} *) ( "psyches" ) |
  (* alias {"value":"directive_key","named":true} *) ( "prompts" ) |
  (* alias {"value":"directive_key","named":true} *) ( "hands" ) |
  (* alias {"value":"directive_key","named":true} *) ( "handoffs" ) |
  (* alias {"value":"directive_key","named":true} *) ( "recall" ) | "lanes" | "context" | "instruct";

_restricted_binding_word ::=
  "until" | "_";

_cap_kind ::=
  (* alias {"value":"cap_kind","named":true} *) ( "psyche" ) |
  (* alias {"value":"cap_kind","named":true} *) ( "skill" ) |
  (* alias {"value":"cap_kind","named":true} *) ( "service" ) |
  (* alias {"value":"cap_kind","named":true} *) ( "prompt" );

_word ::=
  (* token *) ( ? regex "[A-Za-z_][A-Za-z0-9_]*" ? );

type_name ::=
  (* token *) ( ? regex "[A-Z][A-Za-z0-9]*" ? );

identifier ::=
  _identifier;

_identifier ::=
  (* token *) ( ? regex "[a-z][a-z0-9_]*" ? );

_snake_kebab_name ::=
  (* token *) ( ? regex "[a-z][a-z0-9_-]*" ? );

_structural_text ::=
  (* token *) ( (* prec -1 *) ( ? regex "[^#\\r\\n]+" ? ) );

_inline_text ::=
  (* token *) ( (* prec -1 *) ( ? regex "[ \\t]*[^ \\t\\r\\n][^\\r\\n]*" ? ) );

_recovery_text ::=
  (* token *) ( (* prec -1 *) ( ? regex "[^ \\t#\\r\\n][^#\\r\\n]*" ? ) );

newline ::=
  ? external scanner token "newline" ?;

blank_line ::=
  ? external scanner token "blank_line" ?;

_comment_start ::=
  ? external scanner token "_comment_start" ?;

plain_comment ::=
  ? external scanner token "plain_comment" ?;

shebang_comment ::=
  ? external scanner token "shebang_comment" ?;

_program_doc_start ::=
  ? external scanner token "_program_doc_start" ?;

_item_doc_start ::=
  ? external scanner token "_item_doc_start" ?;

_param_doc_start ::=
  ? external scanner token "_param_doc_start" ?;

_comment_end ::=
  ? external scanner token "_comment_end" ?;

_body_start ::=
  ? external scanner token "_body_start" ?;

_empty_body ::=
  ? external scanner token "_empty_body" ?;

_item_start ::=
  ? external scanner token "_item_start" ?;

_item_indent ::=
  ? external scanner token "_item_indent" ?;

_indent ::=
  ? external scanner token "_indent" ?;

_runnable_indent ::=
  ? external scanner token "_runnable_indent" ?;

_dedent ::=
  ? external scanner token "_dedent" ?;

_line_start ::=
  ? external scanner token "_line_start" ?;

_directive_start ::=
  ? external scanner token "_directive_start" ?;

_until_start ::=
  ? external scanner token "_until_start" ?;

_from_start ::=
  ? external scanner token "_from_start" ?;

_reduce_indent ::=
  ? external scanner token "_reduce_indent" ?;

_reduce_text_start ::=
  ? external scanner token "_reduce_text_start" ?;

_text_indent ::=
  ? external scanner token "_text_indent" ?;

_cap_text_start ::=
  ? external scanner token "_cap_text_start" ?;

_raw_text ::=
  ? external scanner token "_raw_text" ?;

_flow_raw_text ::=
  ? external scanner token "_flow_raw_text" ?;

_agic_raw_text ::=
  ? external scanner token "_agic_raw_text" ?;

_error_line ::=
  ? external scanner token "_error_line" ?;

_exec_binding_start ::=
  ? external scanner token "_exec_binding_start" ?;

_operation_binding_start ::=
  ? external scanner token "_operation_binding_start" ?;

_restricted_binding_start ::=
  ? external scanner token "_restricted_binding_start" ?;

_named_binding_start ::=
  ? external scanner token "_named_binding_start" ?;

_missing_required ::=
  ? external scanner token "_missing_required" ?;

integer_literal ::=
  ? external scanner token "integer_literal" ?;

_param_error ::=
  ? external scanner token "_param_error" ?;

_missing_type ::=
  ? external scanner token "_missing_type" ?;
