  "*";

_messages ::=
  (* prec.right 0 *) ( (* field "message" *) ( message ) ( (* field "message" *) ( message ) |
  _trivia )* );

message ::=
  _line_start ( (* field "role" *) ( _role ) colon ( (* field "content" *) (
  (* alias {"value":"content","named":true} *) ( _inline_content ) ) line_end | (* prec.right 0 *) (
  line_end ( (* field "content" *) ( (* alias {"value":"content","named":true} *) ( _block_content )
  ) | blank_line* _comment _trivia* (* field "content" *) (
  (* alias {"value":"content","named":true} *) ( _empty_content ) ) ) ) ) |
  invalid_agic_reserved_message | (* field "content" *) (
  (* alias {"value":"content","named":true} *) ( _message_content ) ) );

_message_content ::=
  (* prec.right 0 *) ( _unroled_message_line ( _unroled_message_line | blank_line
  _unroled_message_line )* blank_line? );

_unroled_message_line ::=
  (* alias {"value":"text_line","named":true} *) ( _agic_raw_text ) newline;

invalid_agic_reserved_message ::=
  (* prec.dynamic -2 *) ( _agic_keyword ( (* alias {"value":"text_line","named":true} *) (
  _diagnostic_text ) )? line_end );

_role ::=
  (* alias {"value":"role","named":true} *) ( "user" ) | (* alias {"value":"role","named":true} *) (
  "assistant" ) | (* alias {"value":"role","named":true} *) ( "tool" );

_pass_statement ::=
  (* prec 1 *) ( _line_start pass_keyword line_end _trivia* );

with_keyword ::=
  "with";

struct_keyword ::=
  "struct";

psyche_keyword ::=
  "psyche";

skill_keyword ::=
  "skill";

service_keyword ::=
  "service";

prompt_keyword ::=
  "prompt";

task_keyword ::=
  "task";

chore_keyword ::=
  "chore";

context_keyword ::=
  "context";

instruct_keyword ::=
  "instruct";

agic_keyword ::=
  "agic";

flow_keyword ::=
  "flow";

flow_run_keyword ::=
  "run";

flow_seek_keyword ::=
  "seek";

flow_ask_keyword ::=
  "ask";

flow_generate_keyword ::=
  "generate";

flow_map_keyword ::=
  "map";

flow_reduce_keyword ::=
  "reduce";

flow_keep_keyword ::=
  "keep";

flow_drop_keyword ::=
  "drop";

flow_sort_keyword ::=
  "sort";

flow_repeat_keyword ::=
  "repeat";

flow_spawn_keyword ::=
  "spawn";

flow_await_keyword ::=
  "await";

flow_until_keyword ::=
  "until";

flow_from_keyword ::=
  "from";

flow_windowing_keyword ::=
  "windowing";

flow_using_keyword ::=
  "using";

flow_if_keyword ::=
  "if";

flow_by_keyword ::=
  "by";

flow_in_keyword ::=
  "in";

flow_lane_keyword ::=
  "lane";

flow_lanes_keyword ::=
  "lanes";

flow_ascending_keyword ::=
  "ascending";

flow_descending_keyword ::=
  "descending";

flow_time_keyword ::=
  "time";

flow_times_keyword ::=
  "times";

flow_first_keyword ::=
  "first";

flow_last_keyword ::=
  "last";

flow_let_keyword ::=
  "let";

flow_exec_keyword ::=
  "exec";

flow_async_keyword ::=
  "async";

pass_keyword ::=
  "pass";

recall_keyword ::=
  "recall";

default_keyword ::=
  "default";

none_keyword ::=
  "none";

_flow_keyword ::=
  with_keyword | struct_keyword | psyche_keyword | skill_keyword | service_keyword | prompt_keyword
  | task_keyword | chore_keyword | context_keyword | instruct_keyword | agic_keyword | flow_keyword
  | flow_run_keyword | flow_seek_keyword | flow_ask_keyword | flow_generate_keyword |
  flow_map_keyword | flow_reduce_keyword | flow_keep_keyword | flow_drop_keyword | flow_sort_keyword
  | flow_repeat_keyword | flow_spawn_keyword | flow_await_keyword | flow_until_keyword |
  flow_from_keyword | flow_windowing_keyword | flow_using_keyword | flow_if_keyword |
  flow_by_keyword | flow_in_keyword | flow_lane_keyword | flow_lanes_keyword |
  flow_ascending_keyword | flow_descending_keyword | flow_time_keyword | flow_times_keyword |
  flow_first_keyword | flow_last_keyword | flow_let_keyword | flow_exec_keyword | flow_async_keyword
  | "_" | (* alias {"value":"role","named":true} *) ( "user" ) |
  (* alias {"value":"role","named":true} *) ( "assistant" ) |
  (* alias {"value":"role","named":true} *) ( "tool" ) | pass_keyword |
  (* alias {"value":"directive_key","named":true} *) ( "models" ) |
  (* alias {"value":"directive_key","named":true} *) ( "tools" ) |
  (* alias {"value":"directive_key","named":true} *) ( "skills" ) |
  (* alias {"value":"directive_key","named":true} *) ( "services" ) |
  (* alias {"value":"directive_key","named":true} *) ( "psyches" ) |
  (* alias {"value":"directive_key","named":true} *) ( "prompts" ) |
  (* alias {"value":"directive_key","named":true} *) ( "hands" ) |
  (* alias {"value":"directive_key","named":true} *) ( "handoffs" ) | recall_keyword;

_agic_keyword ::=
  (* alias {"value":"role","named":true} *) ( "user" ) | (* alias {"value":"role","named":true} *) (
  "assistant" ) | (* alias {"value":"role","named":true} *) ( "tool" ) | pass_keyword |
  (* alias {"value":"directive_key","named":true} *) ( "models" ) |
  (* alias {"value":"directive_key","named":true} *) ( "tools" ) |
  (* alias {"value":"directive_key","named":true} *) ( "skills" ) |
  (* alias {"value":"directive_key","named":true} *) ( "services" ) |
  (* alias {"value":"directive_key","named":true} *) ( "psyches" ) |
  (* alias {"value":"directive_key","named":true} *) ( "prompts" ) |
  (* alias {"value":"directive_key","named":true} *) ( "hands" ) |
  (* alias {"value":"directive_key","named":true} *) ( "handoffs" ) | recall_keyword |
  flow_lanes_keyword | context_keyword | instruct_keyword;

_restricted_binding_word ::=
  flow_until_keyword | "_";

optional_marker ::=
  "?";

assign_operator ::=
  "=";

arrow ::=
  "->";

colon ::=
  ":";

lparen ::=
  "(";

rparen ::=
  ")";

comma ::=
  ",";

_cap_kind ::=
  (* alias {"value":"cap_kind","named":true} *) ( psyche_keyword ) |
  (* alias {"value":"cap_kind","named":true} *) ( skill_keyword ) |
  (* alias {"value":"cap_kind","named":true} *) ( service_keyword ) |
  (* alias {"value":"cap_kind","named":true} *) ( prompt_keyword );

_word ::=
  (* token *) ( ? regex "[A-Za-z_][A-Za-z0-9_]*" ? );

type_name ::=
  (* token *) ( ? regex "[A-Z][A-Za-z0-9]*" ? );

identifier ::=
  _identifier;

_identifier ::=
  (* token *) ( ? regex "[a-z][a-z0-9_]*(_[a-z0-9]+)*" ? );

kebab_name ::=
  (* token *) ( ? regex "[a-z][a-z0-9]*(-[a-z0-9]+)*" ? );

_snake_kebab_name ::=
  (* token *) ( ? regex "[a-z][a-z0-9_-]*" ? );

text_line ::=
  _text_line;

_text_line ::=
  (* token *) ( (* prec -1 *) ( ? regex "[^#\\r\\n]+" ? ) );

_diagnostic_text ::=
  (* token *) ( (* prec -1 *) ( ? regex "[^ \\t#\\r\\n][^#\\r\\n]*" ? ) );

newline ::=
  ? external scanner token "newline" ?;

blank_line ::=
  ? external scanner token "blank_line" ?;

_comment_start ::=
  ? external scanner token "_comment_start" ?;

plain_comment ::=
  ? external scanner token "plain_comment" ?;

shebang_comment ::=
  ? external scanner token "shebang_comment" ?;

_module_doc_start ::=
  ? external scanner token "_module_doc_start" ?;

_item_doc_start ::=
  ? external scanner token "_item_doc_start" ?;

_param_item_doc_start ::=
  ? external scanner token "_param_item_doc_start" ?;

_comment_end ::=
  ? external scanner token "_comment_end" ?;

_indent ::=
  ? external scanner token "_indent" ?;

_dedent ::=
  ? external scanner token "_dedent" ?;

_line_start ::=
  ? external scanner token "_line_start" ?;

_directive_start ::=
  ? external scanner token "_directive_start" ?;

_until_start ::=
  ? external scanner token "_until_start" ?;

_from_start ::=
  ? external scanner token "_from_start" ?;

_reduce_indent ::=
  ? external scanner token "_reduce_indent" ?;

_reduce_text_start ::=
  ? external scanner token "_reduce_text_start" ?;

_text_indent ::=
  ? external scanner token "_text_indent" ?;

_cap_text_start ::=
  ? external scanner token "_cap_text_start" ?;

_raw_text ::=
  ? external scanner token "_raw_text" ?;

_flow_raw_text ::=
  ? external scanner token "_flow_raw_text" ?;

_agic_raw_text ::=
  ? external scanner token "_agic_raw_text" ?;

_error_line ::=
  ? external scanner token "_error_line" ?;

_exec_binding_start ::=
  ? external scanner token "_exec_binding_start" ?;

_operation_binding_start ::=
  ? external scanner token "_operation_binding_start" ?;

_restricted_binding_start ::=
  ? external scanner token "_restricted_binding_start" ?;

_variable_name ::=
  ? external scanner token "_variable_name" ?;

_missing_required ::=
  ? external scanner token "_missing_required" ?;

integer_literal ::=
  ? external scanner token "integer_literal" ?;

_one_integer_literal ::=
  ? external scanner token "_one_integer_literal" ?;

_other_integer_literal ::=
  ? external scanner token "_other_integer_literal" ?;
